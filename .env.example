# Порт HTTP-сервера маркета номеров
FRAGMENT_PORT=2700

# DSN той же Postgres, где работает RuGram.
FRAGMENT_DATABASE_URL=postgres://rugram:CHANGE_ME@127.0.0.1:15432/rugram_main?sslmode=disable

# Демо-код входа (в RuGram по умолчанию тоже 12345)
FRAGMENT_DEV_CODE=12345

# Курс обмена: сколько gram даётся за 1 звезду.
# 5000 звёзд = 1 gram => 1 звезда = 0.0002 gram
FRAGMENT_STARS_TO_GRAM_RATE=0.0002

# Секрет для демо-пополнения (только для разработки)
FRAGMENT_TOPUP_SECRET=change-me

# Время жизни сессии в часах
FRAGMENT_SESSION_TTL_HOURS=24
